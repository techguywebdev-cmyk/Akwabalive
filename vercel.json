{
  "crons": [
    {
      "path": "/api/events/cron/discover-events",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/events/cron/import-events",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/moments/find",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/events/watch",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/events/read-flyers",
      "schedule": "20 7 * * *"
    },
    {
      "path": "/api/events/campus",
      "schedule": "40 7 * * *"
    },
    {
      "path": "/api/reminders/daily",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/seo/indexnow",
      "schedule": "50 7 * * *"
    },
    {
      "path": "/api/calendars/curate",
      "schedule": "20 6 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!api/|_next/).*\\.(?:png|jpg|jpeg|webp|gif|svg|ico))",
      "has": [
        {
          "type": "host",
          "value": "akwabalive.vercel.app"
        }
      ],
      "destination": "https://tsacoal.com/:path",
      "permanent": true
    }
  ]
}
